# Prosperr data pipeline — copy this file to .env and fill in the values.
# .env is git-ignored and never served by the local server. Never commit real keys.

# --- Supabase (Project Settings -> API) ---------------------------------------------
# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# The service_role / secret key (server-side only; never put it in the website)
SUPABASE_SERVICE_KEY=
# Storage bucket for all data (created as PRIVATE if it does not exist)
SUPABASE_BUCKET=mf-data
SUPABASE_BENCHMARK_BUCKET=benchmark-data

# --- Public data sources (no key; change only if a provider moves an endpoint) -------
MFAPI_BASE_URL=https://api.mfapi.in/mf/
AMFI_NAV_URL=https://portal.amfiindia.com/spages/NAVOpen.txt
AMFI_SCHEME_MASTER_URL=https://portal.amfiindia.com/DownloadSchemeData_Po.aspx?mf=0
AMFI_NAV_HISTORY_URL=https://portal.amfiindia.com/DownloadNAVHistoryReport_Po.aspx?frmdt={start}&todt={end}

# --- Pulse Labs (fund analytics API) ------------------------------------------------
PULSE_BASE_URL=https://pulsedb.pulselabs.co.in/rest/api/v1
PULSE_PARTNER=
PULSE_KEY=

# --- Team access password (asked when someone opens the site from another computer) ---
SITE_PASSWORD=
